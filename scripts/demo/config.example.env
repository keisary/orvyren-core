# ORVYREN — testnet demo kit (W3-D): session configuration
# -----------------------------------------------------------------------------
# Copy this file to `scripts/demo/.env` (NOT VERSIONED — `.gitignore` covers `.env`)
# and fill in the values on setup day. FREEZE_V2 rules (E1, E2, E5, J2):
#   * TESTNET wallet only — no real money;
#   * the key is throwaway, generated locally, destroyed after the demo;
#   * never a key in the repository, a message, a screenshot or a report.
#
# The values below are rehearsal PLACEHOLDERS: `--execute`
# refuses them. Only the Circle test USDC is a real address (it is public).

# --- Network (Base Sepolia) --------------------------------------------------
ORVYREN_RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
ORVYREN_CHAIN_ID=84532
ORVYREN_RPC_TIMEOUT_SECONDS=30

# --- Session addresses -------------------------------------------------------
# The 2/3 Safe (avatar): holds the funds, executes the kill switch.
ORVYREN_SAFE_ADDRESS=0x2222222222222222222222222222222222222222
# The throwaway EOA member of the AGENT role: pays its gas, no admin rights.
ORVYREN_AGENT_ADDRESS=0x3333333333333333333333333333333333333333
# The Roles module deployed FOR this Safe (clean instance, not the official one).
ORVYREN_MODULE_ADDRESS=0x4444444444444444444444444444444444444444
# Circle test USDC (Base Sepolia) — public address verified 2026-10-15.
ORVYREN_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Allowlisted recipients B and C (the Zodiac condition is Or(EqualTo(B), EqualTo(C))).
ORVYREN_RECIPIENT_B=0x1111111111111111111111111111111111111111
ORVYREN_RECIPIENT_C=0x5555555555555555555555555555555555555555
# NON-listed recipient for run B2/C2 (attack #12).
ORVYREN_RECIPIENT_UNLISTED=0x9999999999999999999999999999999999999999

# --- Signer (throwaway key) --------------------------------------------------
# Read ONLY by scripts/demo/signer.py, only in --execute mode.
# Never put this value in a versioned file, a chat or a ticket.
ORVYREN_PRIVATE_KEY=

# --- K0 pause (optional) -----------------------------------------------------
# Setting ORVYREN_K0_PAUSED=1 (or creating <session>/PAUSED) blocks every signature:
# it is the immediate off-chain kill switch (B4 P11). Cleared by a human only.
ORVYREN_K0_PAUSED=
