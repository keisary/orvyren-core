# ORVYREN — kit de démo testnet (W3-D) : configuration de session
# -----------------------------------------------------------------------------
# Copier ce fichier en `scripts/demo/.env` (NON VERSIONNÉ — `.gitignore` couvre `.env`)
# et remplir les valeurs le jour du montage. Règles FREEZE_V2 (E1, E2, E5, J2) :
#   * wallet de TESTNET uniquement — aucun argent réel ;
#   * la clé est jetable, générée localement, détruite après la démo ;
#   * jamais de clé dans le dépôt, un message, une capture ou un rapport.
#
# Les valeurs ci-dessous sont des PLACEHOLDERS de répétition : `--execute` les
# refuse. Seul l'USDC de test Circle est une adresse réelle (elle est publique).

# --- Réseau (Base Sepolia) ---------------------------------------------------
ORVYREN_RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
ORVYREN_CHAIN_ID=84532
ORVYREN_RPC_TIMEOUT_SECONDS=30

# --- Adresses de la session --------------------------------------------------
# La Safe 2/3 (avatar) : détient les fonds, exécute le kill switch.
ORVYREN_SAFE_ADDRESS=0x2222222222222222222222222222222222222222
# L'EOA jetable membre du rôle AGENT : paie son gaz, aucun droit d'admin.
ORVYREN_AGENT_ADDRESS=0x3333333333333333333333333333333333333333
# Le module Roles déployé POUR cette Safe (instance propre, pas l'officielle).
ORVYREN_MODULE_ADDRESS=0x4444444444444444444444444444444444444444
# USDC de test Circle (Base Sepolia) — adresse publique vérifiée 2026-10-15.
ORVYREN_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Destinataires allowlistés B et C (la condition Zodiac est Or(EqualTo(B), EqualTo(C))).
ORVYREN_RECIPIENT_B=0x1111111111111111111111111111111111111111
ORVYREN_RECIPIENT_C=0x5555555555555555555555555555555555555555
# Destinataire NON listé du run B2/C2 (attaque #12).
ORVYREN_RECIPIENT_UNLISTED=0x9999999999999999999999999999999999999999

# --- Signer (clé jetable) ----------------------------------------------------
# Lue UNIQUEMENT par scripts/demo/signer.py, uniquement en mode --execute.
# Ne jamais renseigner cette valeur dans un fichier versionné, un chat ou un ticket.
ORVYREN_PRIVATE_KEY=

# --- Pause K0 (optionnelle) --------------------------------------------------
# Poser ORVYREN_K0_PAUSED=1 (ou créer <session>/PAUSED) bloque toute signature :
# c'est le kill switch hors chaîne immédiat (B4 P11). Levée par un humain uniquement.
ORVYREN_K0_PAUSED=
