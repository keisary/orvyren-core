# ORVYREN-Core — variables d'environnement (exemple)
# Copier en .env et remplir. NE JAMAIS commiter .env.
#
# Le prototype tourne sans base externe (SQLite + corpus archivé + mode replay).
# Ces variables ne deviennent nécessaires que pour l'exécution on-chain et la démo hébergée.

# --- Base de données (optionnel en développement : SQLite par défaut) ---
ORVYREN_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Lecture de chaîne ---
ORVYREN_RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
ORVYREN_RPC_URL_BASE_MAINNET=https://mainnet.base.org

# --- Exécution (le signer lit sa clé ici ; jamais dans le dépôt, jamais dans un prompt) ---
# Adresse du wallet « trésorerie » (démonstration, actifs de test uniquement)
ORVYREN_TREASURY_ADDRESS=0x...
# Adresse du wallet « réserve » (destinataire allowlisté)
ORVYREN_RESERVE_ADDRESS=0x...
# Chemin d'un fichier de clé isolé (droits restreints), ou laisser vide si signer externe
ORVYREN_SIGNER_KEYFILE=

# --- Plafonds de la politique de démonstration (alignés sur FREEZE_V1 D9) ---
ORVYREN_MAX_PER_TX=100
ORVYREN_MAX_CUMULATIVE=300
ORVYREN_PERMISSION_TTL_HOURS=24

# --- Budgets de recherche (FREEZE_V1 D11) ---
ORVYREN_MAX_RESEARCH_TASKS=3
ORVYREN_MAX_LLM_CALLS_PER_DECISION=20
ORVYREN_MAX_COST_PER_DECISION_EUR=1.00
